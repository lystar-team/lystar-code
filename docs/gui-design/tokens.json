    "space": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64
    },
    "radius": {
      "none": 0,
      "sm": 4,
      "md": 6,
      "lg": 8,
      "composer": 12,
      "round": 999
    },
    "fontSize": {
      "xs": 12,
      "sm": 13,
      "md": 14,
      "body": 15,
      "lg": 16,
      "title": 18,
      "pageTitle": 24
    },
    "lineHeight": {
      "compact": 1.4,
      "normal": 1.5,
      "reading": 1.65
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "duration": {
      "fast": 120,
      "normal": 160,
      "panel": 200
    }
  },
  "layout": {
    "referenceCanvas": {
      "width": 2816,
      "height": 1640
    },
    "minimumWindow": {
      "width": 1280,
      "height": 800
    },
    "sidebar": {
      "defaultWidth": 320,
      "minimumWidth": 288,
      "maximumWidth": 360
    },
    "inspector": {
      "defaultWidth": 520,
      "minimumWidth": 420,
      "maximumWidth": 680
    },
    "content": {
      "maximumReadingWidth": 1120,
      "horizontalPadding": 32
    },
    "composer": {
      "minimumHeight": 140,
      "maximumHeight": 280,
      "horizontalMargin": 24,
      "bottomMargin": 20
    }
  },
  "component": {
    "icon": {
      "small": 14,
      "default": 16,
      "large": 20
    },
    "hitArea": {
      "minimum": 32,
      "comfortable": 36,
      "primary": 40
    },
    "rowHeight": {
      "session": 36,
      "project": 44,
      "tool": 48,
      "setting": 64,
      "file": 40
    },
    "controlHeight": {
      "compact": 32,
      "default": 36,
      "large": 40
    },
    "borderWidth": 1,
    "focusRingWidth": 2,
    "connectionDot": 8
  },
  "semantic": {
    "light": {
      "canvas": "#FFFFFF",
      "sidebar": "#F6F6F6",
      "surface": "#FFFFFF",
      "surfaceSubtle": "#F3F3F3",
      "surfaceHover": "#ECECEC",
      "surfaceSelected": "#E8E8E8",
      "surfaceDisabled": "#FAFAFA",
      "border": "#E3E3E3",
