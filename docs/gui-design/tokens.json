      "gray950": "#151515",
      "gray975": "#0D0D0D",
      "blue500": "#0169CC",
      "blue400": "#4DA3FF",
      "blue100": "#E8F3FF",
      "blue900": "#0C3157",
      "green500": "#0A9F4A",
      "green400": "#39D27D",
      "green100": "#E8F7EE",
      "green900": "#173D29",
      "amber600": "#C76A00",
