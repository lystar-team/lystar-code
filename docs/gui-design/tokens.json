{
  "$schema": "https://www.designtokens.org/tr/drafts/format/",
  "meta": {
    "name": "LYStar Code GUI",
    "version": 1,
    "date": "2026-08-13",
    "baseGrid": 4,
    "defaultTheme": "system"
