      "shadowOverlay": "0 12px 32px rgba(13, 13, 13, 0.14)"
    },
    "dark": {
      "canvas": "#151515",
      "sidebar": "#242424",
      "surface": "#1D1D1D",
      "surfaceSubtle": "#2B2B2B",
      "surfaceHover": "#303030",
      "surfaceSelected": "#333333",
      "surfaceDisabled": "#191919",
      "border": "#3D3D3D",
      "borderStrong": "#4D4D4D",
      "divider": "#333333",
      "text": "#F5F5F5",
      "textSecondary": "#A6A6A6",
      "textMuted": "#858585",
      "textDisabled": "#6F6F6F",
      "accent": "#4DA3FF",
      "accentHover": "#75B8FF",
      "accentSubtle": "#0C3157",
      "focusRing": "#4DA3FF",
      "success": "#39D27D",
      "successSubtle": "#173D29",
      "warning": "#F59E42",
      "warningSubtle": "#4A2E13",
      "error": "#FF6259",
      "errorSubtle": "#4B211E",
      "diffAddedText": "#61E39A",
      "diffAddedSurface": "#173D29",
      "diffDeletedText": "#FF8A83",
      "diffDeletedSurface": "#4B211E",
      "shadowComposer": "0 8px 24px rgba(0, 0, 0, 0.24)",
      "shadowOverlay": "0 12px 32px rgba(0, 0, 0, 0.36)"
    }
  }
}