      "accentHover": "#005CB4",
      "accentSubtle": "#E8F3FF",
      "focusRing": "#0169CC",
      "success": "#0A9F4A",
      "successSubtle": "#E8F7EE",
      "warning": "#C76A00",
      "warningSubtle": "#FFF3E3",
      "error": "#D92D20",
      "errorSubtle": "#FDECEA",
      "diffAddedText": "#08783A",
      "diffAddedSurface": "#E8F7EE",
      "diffDeletedText": "#B42318",
      "diffDeletedSurface": "#FDECEA",
