{
	"name": "@lystar/code-gui",
	"version": "0.84.1-lystar-gui.3",
	"description": "LYStar Code desktop GUI",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"check": "tsgo -p tsconfig.json --noEmit",
		"check:updater": "node scripts/check-updater-config.mjs",
		"build:sidecar": "node scripts/build-sidecar.mjs",
		"prepare:tauri": "npm run check:updater && npm run build:sidecar",
		"build": "tsgo -p tsconfig.json --noEmit && vite build",
		"test": "vitest --run",
		"tauri": "tauri"
	},
	"dependencies": {
		"@lystar/code-gui-protocol": "0.84.1-lystar-gui.3",
		"@tanstack/react-virtual": "3.14.9",
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/plugin-dialog": "2.7.2",
		"@tauri-apps/plugin-opener": "2.5.4",
		"@tauri-apps/plugin-updater": "2.10.1",
		"highlight.js": "10.7.3",
		"lucide-react": "1.31.0",
		"marked": "18.0.5",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.11.4",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "6.0.5",
		"vite": "8.0.16",
		"vitest": "4.1.9",
		"ws": "8.21.3"
	},
	"license": "MIT"
}
