{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LYStar Code",
  "version": "0.84.1-lystar-gui.1",
  "identifier": "com.lystar.code",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run prepare:tauri && npm run dev",
    "beforeBuildCommand": "npm run prepare:tauri && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LYStar Code",
        "width": 1408,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:1420",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "object-src": "'none'",
        "script-src": "'self' 'unsafe-eval' http://127.0.0.1:1420",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "DeveloperTool",
    "shortDescription": "跨平台编码 Agent 工作台",
    "resources": {
      "resources/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
