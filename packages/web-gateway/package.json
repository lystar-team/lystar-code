{
	"name": "@lystar/code-web-gateway",
	"version": "1.0.0-lystar.3",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"lystar-web": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "node scripts/run-tests.mjs",
		"test:vertical": "node --import tsx --test test/vertical-loop.test.ts",
		"test:integration": "node scripts/run-tests.mjs --integration",
		"dev": "tsx src/cli.ts"
	},
	"dependencies": {
		"@lystar/code-web-runtime": "1.0.0-lystar.3",
		"@lystar/code-web-protocol": "1.0.0-lystar.3",
		"web-push": "3.6.7",
		"ws": "8.21.3"
	},
	"devDependencies": {
		"@types/web-push": "3.6.4",
		"@types/ws": "8.18.1",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT"
}
