{
	"name": "@lystar/code-gui-host",
	"version": "0.84.1-lystar-gui.6",
	"description": "LYStar Code GUI Host",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"lystar-gui-host": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@lystar/code-gui-protocol": "0.84.1-lystar-gui.6"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.1",
		"shx": "0.4.0",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT",
	"private": true
}