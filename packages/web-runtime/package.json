{
	"name": "@lystar/code-web-runtime",
	"version": "1.0.0-lystar.4",
	"description": "LYStar Code Web Runtime",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"lystar-web-runtime": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "vitest --run",
		"test:required": "vitest --run --maxWorkers=1"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.0.0-lystar.4",
		"@earendil-works/pi-coding-agent": "1.0.0-lystar.4",
		"@lystar/code-web-protocol": "1.0.0-lystar.4"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT",
	"private": true
}
