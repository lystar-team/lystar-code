{
	"name": "@earendil-works/pi-tui",
	"version": "1.5.0",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./layout-node": {
			"source": "./src/layout-node.ts",
			"types": "./dist/layout-node.d.ts",
			"import": "./dist/layout-node.js"
		},
		"./viewport": {
			"source": "./src/viewport.ts",
			"types": "./dist/viewport.d.ts",
			"import": "./dist/viewport.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:linux": "native/linux/build.sh",
		"build:native:win32": "node native/win32/build.mjs",
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"prepublishOnly": "npm run clean && npm run build",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts"
	},
	"files": [
		"dist/**/*",
		"native/napi.h",
		"native/clipboard.h",
		"native/win32/prebuilds/**/*.node",
		"native/win32/src/**/*.c",
		"native/win32/build.mjs",
		"native/win32/README.md",
		"native/darwin/prebuilds/**/*.node",
		"native/darwin/src/**/*.m",
		"native/darwin/build.sh",
		"native/darwin/README.md",
		"native/linux/prebuilds/**/*.node",
		"native/linux/src/**/*.{c,h}",
		"native/linux/build.sh",
		"native/linux/README.md",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.11",
		"marked-cjk-friendly": "0.1.2"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0",
		"chalk": "6.0.0"
	}
}
